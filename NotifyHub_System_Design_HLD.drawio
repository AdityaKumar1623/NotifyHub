          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="806" y="545" />
              <mxPoint x="175" y="545" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;HTTP 202&lt;/b&gt; means accepted for asynchronous processing, not proof that the recipient received or read the message." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9D9;strokeColor=#D6B656;fontColor=#4A3B12;fontSize=12;spacing=8;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="610" width="750" height="85" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Reliability:&lt;/b&gt; retries can duplicate external sends if a provider accepted a request but the worker failed before saving success. Use provider idempotency / deduplication where possible." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9D9;strokeColor=#D6B656;fontColor=#4A3B12;fontSize=12;spacing=8;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="850" y="610" width="780.0" height="85" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="API and worker are logically separated by a queue. Do not call this microservices unless independently deployed and operated as separate services. In-process SSE needs shared pub/sub for multi-instance fan-out." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9D9;strokeColor=#D6B656;fontColor=#4A3B12;fontSize=12;spacing=8;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="730" width="1580.0" height="85" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#526273&quot;&gt;&lt;b&gt;━━&lt;/b&gt; Request / command&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#168C8C&quot;&gt;&lt;b&gt;╌╌&lt;/b&gt; Async event / stream&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#C94A4A&quot;&gt;&lt;b&gt;━━&lt;/b&gt; Failure / retry&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1050" y="28" width="560" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c00266c8-e14" name="02 - Request Lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="END-TO-END NOTIFICATION FLOW — STEP BY STEP" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a" value="1. User selects recipient, channel,&lt;br&gt;priority, template and data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78C2;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b" value="2. React validates form and sends&lt;br&gt;REST request using Axios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78C2;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c" value="3. Express checks CORS, rate limit,&lt;br&gt;idempotency and request body." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D28A27;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="140" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d" value="4. Controller validates payload&lt;br&gt;and generates unique jobId." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D28A27;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="310" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e" value="5. MongoDB creates notification&lt;br&gt;record with QUEUED status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#168C8C;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="310" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f" value="6. BullMQ adds job to Redis with&lt;br&gt;priority and retry configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#168C8C;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="310" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g" value="7. Worker consumes job&lt;br&gt;(up to 4 concurrent jobs)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D28A27;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h" value="8. Worker loads template, checks&lt;br&gt;required variables and renders it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E3;strokeColor=#D28A27;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="500" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="i" value="9. Provider adapter attempts&lt;br&gt;EMAIL / SMS / WEBHOOK delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EC;strokeColor=#38934A;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="500" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="j" value="10. Worker stores DELIVERED or&lt;br&gt;failure details in MongoDB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#168C8C;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="690" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k" value="11. Backend emits lifecycle event;&lt;br&gt;SSE sends it to browser." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#168C8C;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="690" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l" value="12. Dashboard updates status,&lt;br&gt;event history and metrics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78C2;strokeWidth=2;fontColor=#14243A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="690" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;fontStyle=1;spacing=3;strokeColor=#526273;fontColor=#526273;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a" target="b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;fontStyle=1;spacing=3;strokeColor=#526273;fontColor=#526273;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;fontStyle=1;spacing=3;strokeColor=#526273;fontColor=#526273;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;fontStyle=1;spacing=3;strokeColor=#526273;fontColor=#526273;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d" target="e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;fontStyle=1;spacing=3;strokeColor=#526273;fontColor=#526273;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e" target="f">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;fontStyle=1;spacing=3;strokeColor=#526273;fontColor=#526273;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f" target="g">
