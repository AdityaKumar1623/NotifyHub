        <mxCell id="failure" value="&lt;b&gt;Failure path:&lt;/b&gt; provider error / timeout → retry with exponential backoff (configured as 4 attempts, 2-second base) → after final failure mark FAILED and place job in DLQ for inspection / replay." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9D9;strokeColor=#D6B656;fontColor=#4A3B12;fontSize=12;spacing=8;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
